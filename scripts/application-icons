#!/usr/bin/env bash
set -euo pipefail

# Bar plugins may not receive Omarchy's app-library API. Find newly installed
# icons directly when Qt's in-process theme cache still reports them missing.
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
IFS=: read -r -a data_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
icon_dirs=("$HOME/.icons" "$data_home/icons")
pixmap_dirs=("$data_home/pixmaps")
for directory in "${data_dirs[@]}"; do
  [[ "$directory" == /* ]] || continue
  icon_dirs+=("$directory/icons")
  pixmap_dirs+=("$directory/pixmaps")
done

# Keep app/device contexts, as Omarchy does, to avoid action-icon collisions.
# Prefer scalable artwork; keep paths with spaces intact.
for extension in svg png xpm; do
  for directory in "${icon_dirs[@]}"; do
    [[ -d "$directory" ]] || continue
    find -L "$directory" \( -path '*/apps/*' -o -path '*/devices/*' \) \
      -type f -name "*.$extension" -print 2>/dev/null || true
  done
  for directory in "${pixmap_dirs[@]}"; do
    [[ -d "$directory" ]] || continue
    find -L "$directory" -maxdepth 1 -type f -name "*.$extension" -print 2>/dev/null || true
  done
done
